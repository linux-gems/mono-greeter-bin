pkgbase = mono-greeter-bin
	pkgdesc = A keyboard-first greeter for greetd, in a terminal: cage + foot + ratatui (prebuilt binary)
	pkgver = 0.1.1
	pkgrel = 1
	url = https://github.com/rafiibrahim8/mono-greeter
	install = mono-greeter-bin.install
	arch = x86_64
	license = MIT
	depends = cage
	depends = foot
	depends = gcc-libs
	depends = glibc
	depends = greetd
	depends = systemd
	depends = ttf-hack-nerd
	optdepends = kwallet-pam: unlock KDE Wallet at login
	optdepends = gnome-keyring: unlock GNOME Keyring at login
	optdepends = xorg-xinit: X11 sessions (started through startx)
	provides = mono-greeter
	conflicts = mono-greeter
	options = !strip
	options = !debug
	backup = etc/mono-greeter/foot.ini
	backup = etc/pam.d/mono-greeter
	source = mono-greeter-0.1.1-linux-x86_64.tar.gz::https://github.com/rafiibrahim8/mono-greeter/releases/download/v0.1.1/mono-greeter-v0.1.1-linux-x86_64.tar.gz

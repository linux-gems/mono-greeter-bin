pkgbase = mono-greeter-bin
	pkgdesc = A keyboard-first greeter for greetd, in a terminal: cage + foot + ratatui (prebuilt binary)
	pkgver = 0.1.3
	pkgrel = 1
	url = https://github.com/rafiibrahim8/mono-greeter
	install = mono-greeter-bin.install
	arch = x86_64
	license = MIT
	depends = cage
	depends = foot
	depends = gcc-libs
	depends = glibc
	depends = greetd
	depends = systemd
	optdepends = ttf-hack-nerd: the intended font (otherwise the default monospace font)
	optdepends = kwallet-pam: unlock KDE Wallet at login
	optdepends = gnome-keyring: unlock GNOME Keyring at login
	optdepends = xorg-xinit: X11 sessions (started through startx)
	provides = mono-greeter
	conflicts = mono-greeter
	options = !strip
	options = !debug
	backup = etc/mono-greeter/foot.ini
	backup = etc/pam.d/mono-greeter
	source = mono-greeter-0.1.3-linux-x86_64.tar.gz::https://github.com/rafiibrahim8/mono-greeter/releases/download/v0.1.3/mono-greeter-v0.1.3-linux-x86_64.tar.gz
	sha256sums = 4083f97f16e08db5cc3525db3830fde95566077ff1e94145b0bf7440cee6d006

pkgname = mono-greeter-bin
